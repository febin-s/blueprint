// Replace this with your deployed Flask backend URL.
const API = "https://YOUR-BACKEND-DOMAIN.com";

async function loadPropertiesFromAPI() {
    const response = await fetch(`${API}/api/properties`);
    if (!response.ok) throw new Error("Could not load properties");
    return await response.json();
}

async function registerPropertyToAPI(data) {
    const response = await fetch(`${API}/api/properties`, {
        method: "POST",
        headers: {"Content-Type": "application/json"},
        body: JSON.stringify(data)
    });

    const result = await response.json();

    if (!response.ok) {
        throw new Error(result.error || "Registration failed");
    }

    return result;
}

async function searchPropertiesAPI(query) {
    const response = await fetch(
        `${API}/api/properties/search?q=${encodeURIComponent(query)}`
    );

    if (!response.ok) throw new Error("Search failed");
    return await response.json();
}
